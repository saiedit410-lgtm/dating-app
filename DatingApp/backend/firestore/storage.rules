rules_version = '2';

// Cloud Storage security rules.
//
// A user may read/write/delete ONLY their own profile photos under
// users/{uid}/photos/{photoId}. Uploads are constrained to image types and a
// size limit (mirrors PhotoConstraints in the app). Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{uid}/photos/{photoId} {
      allow read: if isOwner(uid);

      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');

      allow delete: if isOwner(uid);
    }

    // Verification selfies: owner uploads; owner + admins (reviewers) read.
    match /users/{uid}/verification/{file} {
      allow read: if isOwner(uid) || isAdmin();

      allow write: if isOwner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');

      allow delete: if isOwner(uid) || isAdmin();
    }

    // Secure-by-default: deny anything not explicitly allowed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
