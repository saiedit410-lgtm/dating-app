rules_version = '2';

// Firestore security rules.
//
// Phase 1.2B: users can read and maintain ONLY their own `users/{uid}`
// document. Trust-controlled fields (accountStatus, isVerified) cannot be
// changed by the client — they are server/admin-owned per
// docs/SecurityRequirements.md. All other collections remain closed until
// their feature milestone introduces rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // First-login creation: must be the owner, with the locked initial state.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.isVerified == false;

      // Updates may not change identity or trust/status fields from the client.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.isVerified == resource.data.isVerified;

      allow delete: if false;
    }

    // Secure-by-default: deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
