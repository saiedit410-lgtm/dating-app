rules_version = '2';

// Firestore security rules.
//
// `users/{uid}` holds the PUBLIC profile (readable by any signed-in user, for
// discovery + profile detail). Sensitive data lives in `users/{uid}/private/*`
// and is owner-only. Identity/trust fields (uid, accountStatus, isVerified)
// cannot be changed by the client. Everything else is closed by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Public profile fields are readable by any signed-in user (discovery).
      allow read: if isSignedIn();

      // First-login creation: only the owner, with the locked initial state.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.isVerified == false;

      // Profile/onboarding/photo updates: owner only; identity + trust/status
      // fields are immutable from the client.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.isVerified == resource.data.isVerified;

      allow delete: if false;

      // Private subdocuments (phone number, future: tokens, exact location).
      match /private/{document} {
        allow read, write: if isOwner(userId);
      }
    }

    // Secure-by-default: deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
