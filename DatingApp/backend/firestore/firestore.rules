rules_version = '2';

// Firestore security rules.
//
// `users/{uid}` holds the PUBLIC profile (readable by any signed-in user, for
// discovery + profile detail). Sensitive data lives in `users/{uid}/private/*`
// and is owner-only. Identity/trust fields (uid, accountStatus, isVerified)
// and server-managed fields (lastActiveAt, verifiedAt) cannot be changed
// by the client. Everything else is closed by default.
//
// Phase 2.2 additions:
//   * Discovery preferences live on users/{uid}/private/matchPrefs (owner
//     only, key-whitelisted) — see the private/matchPrefs sub-match.
//   * `lastActiveAt` and `verifiedAt` are SERVER-MANAGED: any client write
//     that touches them is rejected at the rule boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins carry a custom claim. Used for verification approval/rejection and
    // (later) the moderation dashboard.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // True if either user has blocked the other (directional block docs).
    function isBlockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    match /users/{userId} {
      // Public profile fields are readable by any signed-in user (discovery).
      allow read: if isSignedIn();

      // First-login creation: only the owner, with the locked initial state.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.isVerified == false;

      // Profile/onboarding/photo updates: owner may edit profile fields, but
      // identity + trust/status + server-managed fields are immutable from
      // the client. Exact coordinates (exactLat/exactLng) may NEVER live on
      // the public doc — they belong on users/{uid}/private/data. Admins
      // (e.g. verification approval) may change trust/status fields.
      //
      // SERVER-MANAGED FIELDS (Phase 2.2 hardening — the affectedKeys()
      // check ensures a tampered client cannot write them):
      //   - lastActiveAt  (set by Cloud Function on user action)
      //   - verifiedAt    (set by Cloud Function on approval)
      //   - isVerified    (admin-only via separate match clause)
      //   - accountStatus (admin-only via separate match clause)
      allow update: if (isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(<String>[
              'displayName', 'dateOfBirth', 'age', 'gender', 'interestedIn',
              'datingIntent', 'bio', 'city', 'state', 'country', 'photos',
              'profilePhotoUrls', 'profileCompletion', 'onboardingComplete',
              'geohash', 'geohashPrefixes', 'interests', 'updatedAt',
            ])
        && !('exactLat' in request.resource.data)
        && !('exactLng' in request.resource.data)
        && !('lastActiveAt' in request.resource.data.diff(resource.data).affectedKeys())
        && !('verifiedAt' in request.resource.data.diff(resource.data).affectedKeys()))
        || isAdmin();

      allow delete: if false;

      // Private subdocuments. Each doc has a per-doc key-whitelist so a
      // tampered client cannot smuggle trust flags into the private
      // subdoc. Exact lat/lng are written only here, never on the public
      // profile, so other users can never read raw coordinates.
      match /private/data {
        // Phone, exact location, FCM tokens, device fingerprints.
        allow read: if isOwner(userId) || isAdmin();

        allow write: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(<String>[
                'phoneNumber',
                'email',
                'exactLat',
                'exactLng',
                'locationUpdatedAt',
                'fcmTokens',
                'deviceIds',
              ]);
      }

      // Discovery preferences (Phase 2.2). Owner-only; key-whitelisted.
      match /private/matchPrefs {
        allow read: if isOwner(userId) || isAdmin();

        allow write: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(<String>[
                'matchPrefs',
                'updatedAt',
              ])
          && request.resource.data.matchPrefs.diff(
                resource.data.matchPrefs
              ).affectedKeys().hasOnly(<String>[
                'otherAgeMin', 'otherAgeMax', 'requiredGenders',
                'requireIntentMatch', 'intentMatrixFloor',
              ]);
      }

      // FCM device tokens (doc id == token). Owner-only; Cloud Functions read
      // them via the Admin SDK (which bypasses rules) to send pushes.
      match /deviceTokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend requests: `friendRequests/{fromUid}_{toUid}`.
    match /friendRequests/{requestId} {
      // Only the two people involved can read.
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);

      // The sender creates a pending request involving themselves — unless a
      // block exists between the two users.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && requestId ==
            request.resource.data.fromUid + '_' + request.resource.data.toUid
        && !isBlockedBetween(
            request.resource.data.fromUid, request.resource.data.toUid);

      allow update: if isSignedIn()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && (
          // Recipient accepts or rejects a pending request.
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected'])
          ||
          // Sender cancels their own pending request.
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
          ||
          // Sender re-sends after a previous reject/cancel.
          (request.auth.uid == resource.data.fromUid
            && resource.data.status in ['rejected', 'cancelled']
            && request.resource.data.status == 'pending')
        );

      allow delete: if false;
    }

    // Connections: `connections/{sortedPair}`. Created by the accepting
    // recipient of a pending request (verified via the referenced request).
    match /connections/{connId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';

      allow update: if false;
      // Allow either participant to remove the connection (future
      // unfriend / block teardown).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Conversations: `conversations/{sortedPair}` (id == connection id).
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      // Created either at accept time (recipient of the still-pending request)
      // or lazily once the two users are already connected.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && (
          ('requestId' in request.resource.data
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending')
          ||
          exists(/databases/$(database)/documents/connections/$(conversationId))
        );

      // Participants may update the last-message summary (not the roster).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // Messages live under a conversation the user belongs to.
      match /messages/{messageId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function otherParticipant() {
          return participants()[0] == request.auth.uid
            ? participants()[1] : participants()[0];
        }

        allow read: if isSignedIn() && request.auth.uid in participants();

        // Cannot message if a block exists between the two participants.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in participants()
          && !isBlockedBetween(request.auth.uid, otherParticipant());

        // Immutable in this phase (no edit/delete UI yet).
        allow update, delete: if false;
      }
    }

    // Blocks: `blocks/{blockerUid}_{blockedUid}`.
    match /blocks/{blockId} {
      // Both parties may read (needed for mutual-invisibility filtering).
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.blockerUid ||
         request.auth.uid == resource.data.blockedUid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.blockerUid
        && request.resource.data.blockerUid != request.resource.data.blockedUid
        && blockId ==
            request.resource.data.blockerUid + '_' +
            request.resource.data.blockedUid;

      allow update: if false;
      // Only the blocker can unblock.
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.blockerUid;
    }

    // Reports: `reports/{reportId}`. Users may create reports about others;
    // mutations are function-only. Admins may read the queue to triage.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.reporterUid != request.resource.data.reportedUid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Verification requests: `verificationRequests/{uid}` (doc id == uid).
    match /verificationRequests/{requestId} {
      // Owner reads their own request; admins read any (review queue).
      allow read: if isOwner(requestId) || isAdmin();

      // The user submits/re-submits their OWN request as pending; only admins
      // can move it to approved/rejected (users cannot approve themselves).
      allow create, update: if (isOwner(requestId)
          && request.resource.data.uid == requestId
          && request.resource.data.status == 'pending')
        || isAdmin();

      allow delete: if false;
    }

    // Phase 2.3 — Likes: `likes/{fromUid}_{toUid}`.
    // Doc id is the directional pair, so a re-like is idempotent.
    match /likes/{likeId} {
      // Either party to the like can read it. This is the minimum
      // surface area for "Likes Received" + mutual-likes detection.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
         || request.auth.uid == resource.data.toUid);

      // The liker creates their own like. `fromUid` is locked to the
      // caller's uid; the recipient and the timestamp are server-stamped.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid
        && likeId == request.resource.data.fromUid + '_' + request.resource.data.toUid;

      // Only the original liker can remove their like.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.fromUid;

      // Likes are immutable once created.
      allow update: if false;
    }

    // Phase 2.3 — Profile Visitors: `profileVisitors/{viewerUid}_{profileUid}`.
    // Latest-write-wins on the same pair (set with merge: true).
    match /profileVisitors/{visitId} {
      // Only the profile owner can read who viewed them.
      allow read: if isSignedIn() && request.auth.uid == resource.data.profileUid;

      // The viewer records their own visit. `viewerUid` is locked to the
      // caller's uid; the profile uid and the timestamp are server-set.
      allow create, update: if isSignedIn()
        && request.auth.uid == request.resource.data.viewerUid
        && request.resource.data.viewerUid != request.resource.data.profileUid
        && visitId == request.resource.data.viewerUid + '_' + request.resource.data.profileUid;

      allow delete: if false;
    }

    // Phase 2.4 — Admin audit log: `adminActions/{auto}` (doc id auto).
    // The Cloud Function is the only writer; clients can only read.
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Secure-by-default: deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
