rules_version = '2';

// Firestore security rules.
//
// `users/{uid}` holds the PUBLIC profile (readable by any signed-in user, for
// discovery + profile detail). Sensitive data lives in `users/{uid}/private/*`
// and is owner-only. Identity/trust fields (uid, accountStatus, isVerified)
// cannot be changed by the client. Everything else is closed by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True if either user has blocked the other (directional block docs).
    function isBlockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    match /users/{userId} {
      // Public profile fields are readable by any signed-in user (discovery).
      allow read: if isSignedIn();

      // First-login creation: only the owner, with the locked initial state.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.isVerified == false;

      // Profile/onboarding/photo updates: owner only; identity + trust/status
      // fields are immutable from the client.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.isVerified == resource.data.isVerified;

      allow delete: if false;

      // Private subdocuments (phone number, exact location, ...).
      match /private/{document} {
        allow read, write: if isOwner(userId);
      }

      // FCM device tokens (doc id == token). Owner-only; Cloud Functions read
      // them via the Admin SDK (which bypasses rules) to send pushes.
      match /deviceTokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend requests: `friendRequests/{fromUid}_{toUid}`.
    match /friendRequests/{requestId} {
      // Only the two people involved can read.
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);

      // The sender creates a pending request involving themselves — unless a
      // block exists between the two users.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && requestId ==
            request.resource.data.fromUid + '_' + request.resource.data.toUid
        && !isBlockedBetween(
            request.resource.data.fromUid, request.resource.data.toUid);

      allow update: if isSignedIn()
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && (
          // Recipient accepts or rejects a pending request.
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected'])
          ||
          // Sender cancels their own pending request.
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
          ||
          // Sender re-sends after a previous reject/cancel.
          (request.auth.uid == resource.data.fromUid
            && resource.data.status in ['rejected', 'cancelled']
            && request.resource.data.status == 'pending')
        );

      allow delete: if false;
    }

    // Connections: `connections/{sortedPair}`. Created by the accepting
    // recipient of a pending request (verified via the referenced request).
    match /connections/{connId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending';

      allow update: if false;
      // Allow either participant to remove the connection (future
      // unfriend / block teardown).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Conversations: `conversations/{sortedPair}` (id == connection id).
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      // Created either at accept time (recipient of the still-pending request)
      // or lazily once the two users are already connected.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && (
          ('requestId' in request.resource.data
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'pending')
          ||
          exists(/databases/$(database)/documents/connections/$(conversationId))
        );

      // Participants may update the last-message summary (not the roster).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      // Messages live under a conversation the user belongs to.
      match /messages/{messageId} {
        function participants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        function otherParticipant() {
          return participants()[0] == request.auth.uid
            ? participants()[1] : participants()[0];
        }

        allow read: if isSignedIn() && request.auth.uid in participants();

        // Cannot message if a block exists between the two participants.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in participants()
          && !isBlockedBetween(request.auth.uid, otherParticipant());

        // Immutable in this phase (no edit/delete UI yet).
        allow update, delete: if false;
      }
    }

    // Blocks: `blocks/{blockerUid}_{blockedUid}`.
    match /blocks/{blockId} {
      // Both parties may read (needed for mutual-invisibility filtering).
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.blockerUid ||
         request.auth.uid == resource.data.blockedUid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.blockerUid
        && request.resource.data.blockerUid != request.resource.data.blockedUid
        && blockId ==
            request.resource.data.blockerUid + '_' +
            request.resource.data.blockedUid;

      allow update: if false;
      // Only the blocker can unblock.
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.blockerUid;
    }

    // Reports: `reports/{reportId}`. Users may create reports about others;
    // they cannot read, modify, or delete any report (moderation is done by
    // admins via the Admin SDK / a future dashboard).
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.reporterUid != request.resource.data.reportedUid;
      allow read, update, delete: if false;
    }

    // Secure-by-default: deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
