rules_version = '2';

// Initial SECURE-BY-DEFAULT rules for spark-dev.
//
// This denies all client access. The real, per-collection rules (users,
// friendRequests, connections, chats, blocks, reports, ...) are introduced in
// the authentication milestone, derived from docs/SecurityRequirements.md.
// Keeping the default closed guarantees no data is ever world-readable by
// accident before those rules land.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
